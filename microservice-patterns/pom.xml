<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>com.org.pattern</groupId>
    <artifactId>microservice-patterns</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>microservice-patterns</name>
    <description>Microservice design patterns implemented as small runnable Spring Boot services</description>

    <modules>
        <module>circuit-breaker-service</module>
        <module>gateway-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Resilience4j comes from spring-cloud-dependencies (resilience4j-bom 2.3.0): Spring Cloud
                 CircuitBreaker 5.0.x is built on resilience4j-spring-boot3, and 2.4.0's boot3 starter
                 refuses to start on Boot 4 — so both services stay on Spring Cloud's line (as of 2026). -->
        </dependencies>
    </dependencyManagement>

</project>
